# Add these server-only values to Vercel's Production environment variables.
# Never prefix secret values with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-server-only-key
HOST_PASSWORD=replace-with-a-long-random-password
# Optional legacy alternative to SUPABASE_SECRET_KEY:
# SUPABASE_SERVICE_ROLE_KEY=your-legacy-service-role-jwt
